# ---------------------------------------------------------------------------
# TourDesk – Konfiguration
# Kopieren nach ".env" (./install.sh erledigt das und erzeugt sichere Werte).
# Die Datei .env enthält Secrets und gehört NICHT ins Git-Repository.
# ---------------------------------------------------------------------------

# production | development
TOURDESK_ENV=production

# Pflicht: langer Zufallswert, z. B.  openssl rand -base64 48
TOURDESK_SECRET_KEY=bitte-ersetzen

# ---- Datenbank ---------------------------------------------------------------
# Docker: Zugangsdaten für den Postgres-Container (die URL setzt docker-compose.yml selbst)
POSTGRES_USER=tourdesk
POSTGRES_PASSWORD=bitte-ersetzen
POSTGRES_DB=tourdesk
# Native Installation (ohne Docker):
# TOURDESK_DATABASE_URL=postgresql+psycopg://tourdesk:PASSWORT@127.0.0.1:5432/tourdesk

# ---- Web ---------------------------------------------------------------------
# Port im LAN (Docker: Host-Port; nativ: Port des Webservers)
TOURDESK_HTTP_PORT=8080
TOURDESK_PORT=8080
# Docker: Adresse, an die der Port gebunden wird (0.0.0.0 = im ganzen LAN erreichbar)
TOURDESK_BIND=0.0.0.0

# Öffentliche Adresse, falls TourDesk über Cloudflare Tunnel / Reverse Proxy erreichbar ist.
# Leer lassen für reinen LAN-Betrieb.
# TOURDESK_PUBLIC_URL=https://tourdesk.meinedomain.de

# Reverse Proxies, deren X-Forwarded-For / CF-Connecting-IP vertraut wird (kommagetrennt, CIDR erlaubt).
# Docker setzt standardmäßig 127.0.0.1,::1,172.28.0.0/24 (internes Compose-Netz inkl. cloudflared).
# TOURDESK_TRUSTED_PROXIES=127.0.0.1,::1

# Erlaubte Host-Header (kommagetrennt), * = alle
TOURDESK_ALLOWED_HOSTS=*

# Secure-Cookies: auto (über HTTPS automatisch), true, false
TOURDESK_COOKIE_SECURE=auto

# Ersteinrichtung über die Weboberfläche ist nur aus dem lokalen Netz möglich.
# Nur auf true setzen, wenn der erste Admin von außen angelegt werden muss.
TOURDESK_ALLOW_REMOTE_SETUP=false

# Swagger-UI unter /api/docs (in Produktion standardmäßig aus)
TOURDESK_ENABLE_API_DOCS=false

# ---- Optional: Admin automatisch anlegen (Docker-Start) ------------------------
# Wird nur angelegt, wenn der Benutzer noch nicht existiert. Danach kann das Passwort
# hier wieder entfernt werden.
# TOURDESK_ADMIN_USERNAME=admin
# TOURDESK_ADMIN_EMAIL=admin@example.org
# TOURDESK_ADMIN_PASSWORD=

# ---- Sitzungen & Anmeldung ---------------------------------------------------
TOURDESK_SESSION_HOURS=12
TOURDESK_SESSION_REMEMBER_DAYS=30
TOURDESK_SESSION_IDLE_DAYS=7
TOURDESK_PASSWORD_MIN_LENGTH=10
TOURDESK_LOGIN_MAX_ATTEMPTS_PER_IP=20
TOURDESK_LOGIN_WINDOW_MINUTES=15
TOURDESK_LOGIN_LOCKOUT_THRESHOLD=5
TOURDESK_API_RATE_LIMIT_PER_MINUTE=600

# ---- Daten & Logs ------------------------------------------------------------
# Docker verwendet /data (Volume). Nativ z. B. /var/lib/tourdesk
# TOURDESK_DATA_DIR=/var/lib/tourdesk
TOURDESK_LOG_LEVEL=INFO
# json | text
TOURDESK_LOG_FORMAT=json
TOURDESK_LOG_TO_FILE=true

# ---- Crawler (Standardwerte – im Adminbereich zur Laufzeit änderbar) ----------
TOURDESK_CRAWLER_INTERVAL_MINUTES=60
TOURDESK_CRAWLER_USER_AGENT=TourDeskBot/1.0 (+self-hosted concert monitor)
# Kontaktadresse im User-Agent (empfohlen, z. B. E-Mail)
# TOURDESK_CRAWLER_CONTACT=
TOURDESK_WORKER_THREADS=3
TOURDESK_GEOCODER_ENABLED=true
TOURDESK_GEOCODER_URL=https://nominatim.openstreetmap.org

# Optionale API-Schlüssel für zusätzliche Ticket-/Konzertquellen
# TOURDESK_TICKETMASTER_API_KEY=
# TOURDESK_BANDSINTOWN_APP_ID=
# TOURDESK_SONGKICK_API_KEY=

# ---- Cloudflare Tunnel (optional, docker compose --profile tunnel) -----------
# Token aus dem Cloudflare-Zero-Trust-Dashboard (Networks → Tunnels)
# TUNNEL_TOKEN=
